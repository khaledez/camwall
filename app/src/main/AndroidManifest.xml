<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Not for drawing overlays: this is the only non-root way to exempt the app from
         Android 10+ background-activity-start blocking, which otherwise drops the
         startActivity() that BootReceiver makes (logcat: BAL_BLOCK). Grant it with
         `adb shell appops set net.khaledez.camwall SYSTEM_ALERT_WINDOW allow`. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Google TV / Android TV: no touchscreen, leanback UI. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="Cam Wall"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:theme="@style/Theme.CamWall">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:theme="@style/Theme.CamWall">

            <!-- Normal launch from the Google TV row. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Retained so the app is a HOME candidate, but this is NOT how the wall
                 starts on boot — BootReceiver is. Google TV ignores set-home-activity,
                 and disabling its launcher drops the device into setupwraith recovery
                 rather than promoting this. See README. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
